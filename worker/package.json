{
  "name": "sunny-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply sunny --local",
    "db:migrate:remote": "wrangler d1 migrations apply sunny --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply sunny --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "wrangler": "^4.141.0"
  }
}
