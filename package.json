{
  "name": "sunny",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "worker"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm -w web run build",
    "deploy": "npm run build && npm -w worker run deploy",
    "dev:web": "npm -w web run dev",
    "dev:phone": "npm -w web run dev -- --host",
    "dev:worker": "npm -w worker run dev",
    "typecheck": "npm -w web run typecheck && npm -w worker run typecheck",
    "test": "npm -w worker run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "http_ece": "^1.2.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
